NODE_ENV=development
PORT=4000
# Локально (schema.prisma → sqlite). Для PostgreSQL в проде см. .env.production.example
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_AUDIENCE="tour-api"
CLIENT_ORIGIN="http://localhost:5173"
# За reverse proxy (Railway): true или 1
TRUST_PROXY="false"
JSON_BODY_LIMIT="256kb"
# REFRESH_COOKIE_NAME="tour_rt"
# REFRESH_COOKIE_MAX_AGE_MS=2592000000
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_API_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=25
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_REFRESH_MAX=60
# RATE_LIMIT_REFRESH_WINDOW_MS=900000
