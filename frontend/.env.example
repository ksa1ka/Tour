# Локальная разработка: запросы идут на /api через прокси Vite.
# Укажите тот же хост/порт, что и у бэкенда (см. backend/.env → PORT), иначе будет ECONNREFUSED.
# Пример, если API на 4002:
# VITE_API_PROXY_TARGET=http://localhost:4002
#
# Альтернатива — только порт (по умолчанию 4000, как в backend env.ts):
# VITE_API_PORT=4002
#
# VITE_API_URL=
